# Copy this file to .env. scripts/start.sh loads it before starting all four
# services. Do not commit credentials.
DASHSCOPE_API_KEY=your-api-key
DASHSCOPE_BASE_URL=https://your-llm-endpoint.example.com/v1

# Port B uses VISTA3D unless a request explicitly selects another installed
# backend. scripts/setup.sh installs the VISTA3D source at this default path.
SEGMENTATION_BACKEND=vista3d
# VISTA3D_ROOT=/absolute/path/to/VISTA/vista3d
# VISTA3D_CONFIG=/absolute/path/to/infer.yaml

PORT_B_INTERNAL=http://127.0.0.1:8765
PUBLIC_BASE_URL=http://127.0.0.1:8898
